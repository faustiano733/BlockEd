<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <!-- Fundo -->
    <ImageView
        android:id="@+id/bgImage"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:scaleType="centerCrop"
        android:src="@drawable/blue_bg7"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Formulário branco -->
    <LinearLayout
        android:id="@+id/formContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:background="@drawable/bg_form_bottom"
        android:padding="24dp"
        android:elevation="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHeight_percent="0.7">

        <!-- Cabeçalho -->
        <TextView
            android:id="@+id/formTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Dados do estudante"
            android:textColor="#3575ff"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_gravity="center"
            android:layout_marginBottom="16dp" />

        <!-- Progress bar -->
        <ProgressBar
            android:id="@+id/progressBar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="12dp"
            android:progress="25"
            android:max="100"
            android:progressDrawable="@drawable/progress_bar"
            android:layout_marginBottom="24dp" />

        <LinearLayout
            android:id="@+id/loadingContainer"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHeight_percent="0.7"
            android:layout_height="match_parent"
            android:layout_width="match_parent"
            android:gravity="center"
            android:visibility="gone">
            
            <ProgressBar
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:indeterminate="true"
                android:indeterminateTint="#3575ff" />

        </LinearLayout>
        <!-- Conteúdo rolável -->
        <ScrollView
            android:id="@+id/formScroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:fillViewport="true"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                
                <Space
                    android:layout_width="match_parent" 
                    android:layout_height="7dp"
                    />

                <LinearLayout
                    android:id="@+id/tokenContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:layout_marginTop="40dp"
                    android:layout_marginBottom="55dp"
                    android:visibility="gone">

                    <EditText
                        android:id="@+id/token1"
                        android:layout_width="0dp"
                        android:layout_weight=".10"
                        android:layout_height="wrap_content"
                        android:background="@drawable/token_background"
                        android:layout_marginTop="2dp"
                        android:layout_marginBottom="10px"
                        android:layout_marginRight="10px"
                        android:gravity="center"
                        android:textSize="35px"
                        android:maxLines="1"
                        android:maxLength="1"
                        android:textAllCaps="true"
                        android:inputType="textCapCharacters" />
            

                    <EditText
                        android:id="@+id/token2"
                        android:layout_width="0dp"
                        android:layout_weight=".10"
                        android:layout_height="wrap_content"
                        android:background="@drawable/token_background"
                        android:layout_marginTop="2dp"
                        android:layout_marginBottom="10px"
                        android:layout_marginRight="10px"
                        android:gravity="center"
                        android:textSize="35px"
                        android:maxLines="1"
                        android:maxLength="1"
                        android:textAllCaps="true"
                        android:inputType="textCapCharacters"  />

                    <EditText
                        android:id="@+id/token3"
                        android:layout_width="0dp"
                        android:layout_weight=".10"
                        android:layout_height="wrap_content"
                        android:background="@drawable/token_background"
                        android:layout_marginTop="2dp"
                        android:layout_marginBottom="10px"
                        android:layout_marginRight="10px"
                        android:gravity="center"
                        android:textSize="35px"
                        android:maxLines="1"
                        android:maxLength="1"
                        android:textAllCaps="true"
                        android:inputType="textCapCharacters"  />

                    <EditText
                        android:id="@+id/token4"
                        android:layout_width="0dp"
                        android:layout_weight=".10"
                        android:layout_height="wrap_content"
                        android:background="@drawable/token_background"
                        android:layout_marginTop="2dp"
                        android:layout_marginBottom="10px"
                        android:layout_marginRight="10px"
                        android:gravity="center"
                        android:textSize="35px"
                        android:maxLines="1"
                        android:maxLength="1"
                        android:textAllCaps="true"
                        android:inputType="textCapCharacters"  />

                    <TextView
                        android:layout_width="wrap_content  "
                        android:layout_height="wrap_content"
                        android:layout_marginRight="10px"
                        android:textSize="40px" 
                        android:text="-"/>

                    <EditText
                        android:id="@+id/token5"
                        android:layout_width="0dp"
                        android:layout_weight=".10"
                        android:layout_height="wrap_content"
                        android:background="@drawable/token_background"
                        android:layout_marginTop="2dp"
                        android:layout_marginBottom="10px"
                        android:layout_marginRight="10px"
                        android:gravity="center"
                        android:textSize="35px"
                        android:maxLines="1"
                        android:maxLength="1"
                        android:textAllCaps="true"
                        android:inputType="textCapCharacters"  />

                    <EditText
                        android:id="@+id/token6"
                        android:layout_width="0dp"
                        android:layout_weight=".10"
                        android:layout_height="wrap_content"
                        android:background="@drawable/token_background"
                        android:layout_marginTop="2dp"
                        android:layout_marginBottom="10px"
                        android:layout_marginRight="10px"
                        android:gravity="center"
                        android:textSize="35px"
                        android:maxLines="1"
                        android:maxLength="1"
                        android:textAllCaps="true"
                        android:inputType="textCapCharacters"  />

                    <EditText
                        android:id="@+id/token7"
                        android:layout_width="0dp"
                        android:layout_weight=".10"
                        android:layout_height="wrap_content"
                        android:background="@drawable/token_background"
                        android:layout_marginTop="2dp"
                        android:layout_marginBottom="10px"
                        android:layout_marginRight="10px"
                        android:gravity="center"
                        android:textSize="35px"
                        android:maxLines="1"
                        android:maxLength="1"
                        android:textAllCaps="true"
                        android:inputType="textCapCharacters"  />

                    <EditText
                        android:id="@+id/token8"
                        android:layout_width="0dp"
                        android:layout_weight=".10"
                        android:layout_height="wrap_content"
                        android:background="@drawable/token_background"
                        android:layout_marginTop="2dp"
                        android:layout_marginBottom="10px"
                        android:gravity="center"
                        android:textSize="35px"
                        android:maxLines="1"
                        android:maxLength="1"
                        android:textAllCaps="true"
                        android:inputType="textCapCharacters"  />
                    
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/dataContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <Space
                        android:layout_width="match_parent" 
                        android:layout_height="7dp"
                    />
                    <EditText
                        android:id="@+id/name"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Ex: João Silva"
                        android:background="@drawable/edittext_background"
                        android:padding="12dp"
                        android:textSize="14sp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Nome do aluno"
                        android:textSize="13sp"
                        android:textColor="#333" 
                        android:layout_marginLeft="20px"
                        android:translationY="-56.5sp"
                        android:background="#fff"
                        android:padding="3dp"/>

                    <EditText
                        android:id="@+id/date"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="DD/MM/AAAA"
                        android:background="@drawable/edittext_background"
                        android:padding="12dp"
                        android:textSize="14sp"
                        android:maxLength="10"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Data de nascimento"
                        android:textSize="13sp"
                        android:textColor="#333" 
                        android:layout_marginLeft="20px"
                        android:translationY="-56sp"
                        android:background="#fff"
                        android:padding="3dp"/>

                </LinearLayout>

                <Button
                    android:id="@+id/fase1Btn"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Próximo"
                    android:textColor="#fff"
                    android:textSize="13sp"
                    android:background="@drawable/button_background" />

                <LinearLayout
                    android:id="@+id/fase2Buttons"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:visibility="gone">
                    
                    <Button
                        android:id="@+id/back_button"
                        android:layout_width="0dp"
                        android:layout_weight=".48"
                        android:layout_height="wrap_content"
                        android:text="Voltar"
                        android:textColor="#0a0a0a"
                        android:textSize="13sp"
                        android:background="@drawable/back_button_background" />

                    <Space
                        android:layout_width="0dp"
                        android:layout_weight=".04" 
                        android:layout_height="7dp"/>

                    <Button
                        android:id="@+id/buttonSave"
                        android:layout_width="0dp"
                        android:layout_weight=".48"
                        android:layout_height="wrap_content"
                        android:text="Finalizar"
                        android:textColor="#fff"
                        android:textSize="13sp"
                        android:background="@drawable/button_background" />
                </LinearLayout>
                <!-- Mantém aqui o mesmo conteúdo que você já tinha -->

            </LinearLayout>
        </ScrollView>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>

